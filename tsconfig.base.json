{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom", "esnext.temporal", "esnext.intl"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@semantic-components/ui-lab": ["libs/ui-lab/src/index.ts"],
      "@semantic-components/ui-lab/animated-counter": [
        "libs/ui-lab/animated-counter/src/index.ts"
      ],
      "@semantic-components/ui": ["libs/ui/src/index.ts"],
      "@semantic-components/code": ["libs/code/src/index.ts"],
      "@semantic-components/carousel": ["libs/carousel/src/index.ts"],
      "@semantic-components/phone-input": ["libs/phone-input/src/index.ts"],
      "@semantic-components/data-table": ["libs/data-table/src/index.ts"],
      "@semantic-components/qr-code": ["libs/qr-code/src/index.ts"],
      "@semantic-components/pdf-viewer": ["libs/pdf-viewer/src/index.ts"],
      "@semantic-components/editor": ["libs/editor/src/index.ts"],
      "@semantic-components/editor/align": ["libs/editor/align/src/index.ts"],
      "@semantic-components/editor/bubble-menu": [
        "libs/editor/bubble-menu/src/index.ts"
      ],
      "@semantic-components/editor/highlight": [
        "libs/editor/highlight/src/index.ts"
      ],
      "@semantic-components/editor/images": ["libs/editor/images/src/index.ts"],
      "@semantic-components/editor/markdown": [
        "libs/editor/markdown/src/index.ts"
      ],
      "@semantic-components/editor/scripts": [
        "libs/editor/scripts/src/index.ts"
      ],
      "@semantic-components/editor/search": ["libs/editor/search/src/index.ts"],
      "@semantic-components/editor/tables": ["libs/editor/tables/src/index.ts"],
      "@semantic-components/charts": ["libs/charts/src/index.ts"],
      "@semantic-components/mcp-server": ["libs/mcp-server/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
