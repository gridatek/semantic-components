{
  "name": "custom",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/styles/custom/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/styles/custom",
        "browser": "apps/styles/custom/src/main.ts",
        "polyfills": ["temporal-polyfill/global", "@angular/localize/init"],
        "tsConfig": "apps/styles/custom/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/styles/custom/public"
          }
        ],
        "styles": ["apps/styles/custom/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "readyWhen": {
        "signal": true
      },
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "custom:build:production"
        },
        "development": {
          "buildTarget": "custom:build:development"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "port": 4201,
        "staticFilePath": "dist/apps/styles/custom/browser",
        "spa": true,
        "watch": false
      },
      "readyWhen": {
        "signal": true
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
