{
  "name": "showcase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/showcase/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/showcase",
        "browser": "apps/showcase/src/main.ts",
        "polyfills": ["apps/showcase/src/polyfills.ts"],
        "tsConfig": "apps/showcase/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/showcase/public"
          },
          {
            "glob": "*.svg",
            "input": "node_modules/country-flag-icons/3x2",
            "output": "flags"
          },
          {
            "glob": "zxing_reader.wasm",
            "input": "node_modules/zxing-wasm/dist/reader",
            "output": "zxing"
          }
        ],
        "styles": [
          "apps/showcase/src/styles.css",
          {
            "input": "libs/styles/nova/src/typeset-variables.css",
            "bundleName": "typeset-variables-nova",
            "inject": false
          },
          {
            "input": "libs/styles/lyra/src/typeset-variables.css",
            "bundleName": "typeset-variables-lyra",
            "inject": false
          },
          {
            "input": "libs/styles/maia/src/typeset-variables.css",
            "bundleName": "typeset-variables-maia",
            "inject": false
          },
          {
            "input": "libs/styles/vega/src/typeset-variables.css",
            "bundleName": "typeset-variables-vega",
            "inject": false
          },
          {
            "input": "libs/styles/mira/src/typeset-variables.css",
            "bundleName": "typeset-variables-mira",
            "inject": false
          },
          {
            "input": "libs/styles/luma/src/typeset-variables.css",
            "bundleName": "typeset-variables-luma",
            "inject": false
          },
          {
            "input": "libs/styles/rhea/src/typeset-variables.css",
            "bundleName": "typeset-variables-rhea",
            "inject": false
          },
          {
            "input": "libs/styles/sera/src/typeset-variables.css",
            "bundleName": "typeset-variables-sera",
            "inject": false
          },
          {
            "input": "libs/styles/nova/src/editor.css",
            "bundleName": "editor-nova",
            "inject": false
          },
          {
            "input": "libs/styles/lyra/src/editor.css",
            "bundleName": "editor-lyra",
            "inject": false
          },
          {
            "input": "libs/styles/maia/src/editor.css",
            "bundleName": "editor-maia",
            "inject": false
          },
          {
            "input": "libs/styles/vega/src/editor.css",
            "bundleName": "editor-vega",
            "inject": false
          },
          {
            "input": "libs/styles/mira/src/editor.css",
            "bundleName": "editor-mira",
            "inject": false
          },
          {
            "input": "libs/styles/luma/src/editor.css",
            "bundleName": "editor-luma",
            "inject": false
          },
          {
            "input": "libs/styles/rhea/src/editor.css",
            "bundleName": "editor-rhea",
            "inject": false
          },
          {
            "input": "libs/styles/sera/src/editor.css",
            "bundleName": "editor-sera",
            "inject": false
          },
          {
            "input": "libs/styles/nova/src/scrollbar-variables.css",
            "bundleName": "scrollbar-variables-nova",
            "inject": false
          },
          {
            "input": "libs/styles/lyra/src/scrollbar-variables.css",
            "bundleName": "scrollbar-variables-lyra",
            "inject": false
          },
          {
            "input": "libs/styles/maia/src/scrollbar-variables.css",
            "bundleName": "scrollbar-variables-maia",
            "inject": false
          },
          {
            "input": "libs/styles/vega/src/scrollbar-variables.css",
            "bundleName": "scrollbar-variables-vega",
            "inject": false
          },
          {
            "input": "libs/styles/mira/src/scrollbar-variables.css",
            "bundleName": "scrollbar-variables-mira",
            "inject": false
          },
          {
            "input": "libs/styles/luma/src/scrollbar-variables.css",
            "bundleName": "scrollbar-variables-luma",
            "inject": false
          },
          {
            "input": "libs/styles/rhea/src/scrollbar-variables.css",
            "bundleName": "scrollbar-variables-rhea",
            "inject": false
          },
          {
            "input": "libs/styles/sera/src/scrollbar-variables.css",
            "bundleName": "scrollbar-variables-sera",
            "inject": false
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "4mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "ssr": {
          "browser": "apps/showcase/src/main-ssr.ts",
          "polyfills": ["temporal-polyfill/global"],
          "server": "apps/showcase/src/main.server.ts",
          "outputMode": "server",
          "ssr": {
            "entry": "apps/showcase/src/server.ts"
          },
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false,
          "security": {
            "allowedHosts": ["localhost"]
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "readyWhen": {
        "signal": true
      },
      "options": {
        "prebundle": {
          "exclude": ["shiki", "@shikijs/langs", "@shikijs/themes"]
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "showcase:build:production"
        },
        "development": {
          "buildTarget": "showcase:build:development"
        },
        "ssr": {
          "buildTarget": "showcase:build:development,ssr",
          "prebundle": false
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "port": 4200,
        "staticFilePath": "dist/apps/showcase/browser",
        "spa": true,
        "watch": false
      },
      "readyWhen": {
        "signal": true
      }
    },
    "serve-ssr": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/showcase/server/server.mjs > dist/ssr-showcase.log 2>&1",
        "env": {
          "PORT": "4200"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
