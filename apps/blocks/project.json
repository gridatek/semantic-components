{
  "name": "blocks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/blocks/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/blocks",
        "browser": "apps/blocks/src/main.ts",
        "polyfills": ["temporal-polyfill/global", "@angular/localize/init"],
        "tsConfig": "apps/blocks/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/blocks/public"
          }
        ],
        "styles": ["apps/blocks/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "ssr": {
          "browser": "apps/blocks/src/main.ssr.ts",
          "server": "apps/blocks/src/main.server.ts",
          "outputMode": "server",
          "ssr": {
            "entry": "apps/blocks/src/server.ts"
          },
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false,
          "security": {
            "allowedHosts": ["localhost"]
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "readyWhen": {
        "signal": true
      },
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "blocks:build:production"
        },
        "development": {
          "buildTarget": "blocks:build:development"
        },
        "ssr": {
          "buildTarget": "blocks:build:development,ssr"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "dependsOn": ["build"],
      "options": {
        "port": 4201,
        "staticFilePath": "dist/apps/blocks/browser",
        "spa": true,
        "watch": false
      },
      "readyWhen": {
        "signal": true
      }
    },
    "serve-ssr": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/blocks/server/server.mjs > dist/ssr-blocks.log 2>&1",
        "env": {
          "PORT": "4201"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "blocks:build",
        "format": "json",
        "outputPath": "apps/blocks/public/i18n",
        "outFile": "messages.json"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
